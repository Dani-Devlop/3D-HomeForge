generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// پروژه کابینت‌سازی: شامل مشخصات فضای بازسازی‌شده و وضعیت صحنه سه‌بعدی
model Project {
  id          String      @id @default(cuid())
  name        String
  roomType    String      @default("kitchen")
  roomSpec    String      @default("{}") // JSON: ابعاد، رنگ‌ها، پنجره‌ها و درب‌های فضا
  sceneState  String      @default("{}") // JSON: آبجکت‌های صحنه (کابینت/دکور/چراغ)
  thumbnail   String? // تصویر بندانگشتی صحنه (dataURL)
  isPublic    Boolean     @default(false) // عمومی (نمونه‌کار) یا خصوصی (فقط با لینک)
  folderId    String? // پوشه مشتری — همه پروژه‌های یک مشتری در یک پوشه
  folder      Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // CRM — مشخصات مشتری و زمان‌بندی پروژه (مدیریت فقط توسط مدیر)
  clientName  String? // نام مشتری
  clientPhone String? // شماره تماس مشتری
  address     String? // مکان اجرا (آدرس محل کار)
  stage       String      @default("visit") // visit | design | build | install | delivered
  dealAt      DateTime? // تاریخ قرارداد
  contractAmount Float? // مبلغ قرارداد (تومان)
  contractPhoto  String? // عکس قرارداد (dataURL — اختیاری)
  invoicePhoto   String? // عکس فاکتور (dataURL — اختیاری)
  visitAt     DateTime? // زمان بازدید
  installAt   DateTime? // زمان اجرا و پیاده‌سازی
  dueAt       DateTime? // زمان اتمام
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  shareLinks  ShareLink[]
}

// پوشه مشتری: همه پروژه‌های یک مشتری (قبلی یا فعلی) در یک پوشه نگه‌داری می‌شود
model Folder {
  id        String    @id @default(cuid())
  name      String // نام مشتری
  phone     String? // شماره تماس مشتری (اختیاری)
  createdAt DateTime  @default(now())
  projects  Project[]
}

// لینک اشتراکی امضاشده (بدون ایمیل) با نقش پیش‌فرض و تاریخ انقضا
model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique // توکن امضاشده HMAC: payload.signature
  shortCode String?   @unique // کد کوتاه لینک (مثلاً k7m3xq) — URL کوتاه برای مشتری
  role      String    @default("viewer") // viewer | modifier
  active    Boolean   @default(true)
  expiresAt DateTime
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  guests    Guest[]
  createdAt DateTime  @default(now())
}

// مهمان (مشتری) که با لینک وارد شده و نام خود را ثبت کرده است
model Guest {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#888888")
  role        String    @default("viewer") // viewer | modifier (قابل تغییر توسط کابینت‌ساز)
  lastSeenAt  DateTime  @default(now())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

// پریست: ترکیبی از کابینت‌ها/دکورها که کابینت‌ساز ذخیره می‌کند تا در پروژه‌های بعدی استفاده شود
model Preset {
  id        String   @id @default(cuid())
  name      String
  data      String // JSON: آرایه‌ای از آبجکت‌ها با آفست نسبی
  createdAt DateTime @default(now())
}

// نمونه‌کار: کارهای نمایشی که مدیر برای صفحه عمومی (لندینگ مشتری) منتخب می‌کند
model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String   @default("kitchen") // kitchen | bedroom | living | office | other
  image       String   @default("") // تصویر (اختیاری — وقتی مدل سه‌بعدی زنده هست)
  roomSpec    String   @default("{}") // JSON RoomSpec — اگر ست باشد، کارت به‌صورت مدل سه‌بعدی زنده نمایش داده می‌شود
  sceneState  String   @default("{}") // JSON SceneState {objects:[...]} — آبجکت‌های صحنه زنده
  visible     Boolean  @default(true) // نمایش در صفحه عمومی
  sortOrder   Int      @default(0) // ترتیب نمایش (کوچک‌تر = جلوتر)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// تنظیمات سراسری (مثل هش رمز مدیر)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
